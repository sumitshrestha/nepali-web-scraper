# .env.example
# Copy this file to .env and fill in your values.
# All variables except YOUTUBE_API_KEY are optional — defaults are shown.

# =============================================================================
# REQUIRED
# =============================================================================

# YouTube Data API v3 key.
# Get one at: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_key_here

# Directory where scrap.py writes per-video comment files and summary.json.
# Should match YOUTUBE_INPUT_DIR above so the ETL can find the output.
OUTPUT_DIR=nepali_comments

# Path for the scraper's rotating log file.
LOG_FILE=scraper.log

# Number of top videos (by comment count) to scrape in automatic discovery mode.
# Ignored when --videos or VIDEO_IDS is supplied.
# Default: 20
TOP_N=20

# Maximum search results fetched per query during automatic discovery.
# API maximum is 50.  Default: 50
MAX_RESULTS=50

# Comma-separated list of YouTube video IDs to scrape instead of running
# automatic discovery. Mirrors the --videos CLI flag.
# Example: VIDEO_IDS=dQw4w9WgXcQ,abc123xyz
# VIDEO_IDS=

# Enable Nepali language filtering during scraping.
#   true  — keep only romanized/mixed Nepali comments (default, saves disk space)
#   false — download all comments; filtering deferred entirely to youtube-etl.py
# Note: if you set this to false, set YOUTUBE_LINGUA_NEPALI_THRESHOLD in the
# ETL section above to your desired cutoff — the ETL will do the full filter.
# Values: true | false.  Default: true
FILTER_COMMENTS=true

# Lingua confidence threshold used by the scraper to discard non-Nepali comments
# during scraping (only active when FILTER_COMMENTS=true).
# NOTE: due to a bug in scrap.py this was previously ignored (always defaulted
# to 0.85). Apply the fix in scrap_patch.py for this variable to take effect.
# Range: 0.0–1.0.  Default: 0.85
LINGUA_CONFIDENCE_THRESHOLD=0.85

# --- Rate-limit / retry tuning ---

# Maximum retries for transient errors (per-minute 429s, 5xx server errors).
# Default: 6
TRANSIENT_MAX_RETRIES=6

# Initial back-off wait for the first transient retry, in seconds.
# Each subsequent attempt doubles this (exponential back-off).  Default: 5
RATE_LIMIT_BASE_WAIT=5

# Hard ceiling on any single back-off sleep, in seconds.  Default: 120
RATE_LIMIT_MAX_WAIT=120

# Pause between Phase 1 API calls (search queries, video-detail batches).
# Default: 0.5
INTER_REQUEST_DELAY=0.5

# Pause between comment-page fetches in Phase 2.  Default: 0.2
PAGE_FETCH_DELAY=0.2

# =============================================================================
# OPTIONAL — video selection
# =============================================================================

# Comma-separated YouTube video IDs to scrape directly, bypassing automatic
# search discovery.  Equivalent to passing --videos on the command line.
# If unset (or empty), the scraper discovers the top TOP_N videos via search.
#
# Example: VIDEO_IDS=dQw4w9WgXcQ,abc123xyz,foo456bar
VIDEO_IDS=

# How many videos to scrape in automatic discovery mode (default: 20).
TOP_N=20

# Maximum search results fetched per query — YouTube API hard-caps this at 50.
MAX_RESULTS=50

# Enable/disable Nepali comment filtering during scraping.
#   true  (default) – only romanized/mixed Nepali comments are kept
#   false            – download ALL comments; filtering is deferred to
#                      a later ETL job
FILTER_COMMENTS=true


# =============================================================================
# OPTIONAL — output paths
# =============================================================================

# Directory where per-video JSON files, checkpoints, and summary.json are saved.
OUTPUT_DIR=nepali_comments

# Rotating log file path (5 MB × 3 backups).
LOG_FILE=scraper.log


# =============================================================================
# OPTIONAL — language filtering
# =============================================================================

# Lingua confidence threshold (0.0–1.0) above which a comment is discarded as
# English or Spanish.
#   0.90 = stricter — discards more aggressively (fewer false keeps)
#   0.85 = default — balanced
#   0.75 = lenient  — keeps more borderline comments
LINGUA_CONFIDENCE_THRESHOLD=0.85


# =============================================================================
# OPTIONAL — rate-limit / retry tuning
# =============================================================================

# Maximum number of retry attempts for transient errors (per-minute 429s and
# 5xx server errors) before giving up on a request.  Each attempt waits 2×
# longer than the last, starting at RATE_LIMIT_BASE_WAIT seconds.
TRANSIENT_MAX_RETRIES=6

# Initial back-off delay (seconds) on the first transient retry.
# Doubles each attempt: 5 → 10 → 20 → 40 → 80 → 120 (capped).
RATE_LIMIT_BASE_WAIT=5

# Hard ceiling (seconds) on any single back-off sleep.
RATE_LIMIT_MAX_WAIT=120

# Pause (seconds) between consecutive Phase 1 API calls — search queries and
# video-detail batches.  Increase if you see frequent soft rate-limit errors
# during the discovery phase.
INTER_REQUEST_DELAY=0.5

# Pause (seconds) between comment-page fetches in Phase 2.
PAGE_FETCH_DELAY=0.2

# IRC Client configuration
IRC_SERVER=your_irc_server_here
IRC_PORT=your_irc_port_here
IRC_CHANNEL=your_irc_channel_here
IRC_NICK=your_irc_nick_here
IRC_REALNAME=your_irc_realname_here
IRC_IDENT=your_irc_ident_here