# systemd service file for the Nepali comment scraper
#
# SETUP (run on your VPS after copying this file):
#   sudo cp scraper.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable scraper   # auto-start on boot
#   sudo systemctl start  scraper   # start now
#
# Useful commands:
#   sudo systemctl status  scraper                                         # quick status
#   sudo journalctl -u scraper -f                                          # live stdout stream
#   tail -f /home/sumit/project/scrap/youtube-scraper/scraper.log         # detailed file log
#   sudo systemctl stop    scraper                                         # graceful stop
#   sudo systemctl restart scraper                                         # restart

[Unit]
Description=Nepali YouTube Comment Scraper
After=network-online.target
Wants=network-online.target

[Service]
User=sumit
WorkingDirectory=/home/sumit/project/scrap/youtube-scraper
ExecStart=/usr/bin/python3 /home/sumit/project/scrap/youtube-scraper/scrap.py

# Restart automatically on crash; not on manual stop
Restart=on-failure
RestartSec=30

# Allow up to 10 s for clean shutdown on SIGTERM
TimeoutStopSec=10

# Both stdout and stderr go to journald (journalctl -u scraper -f)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nepali-scraper

# Flush Python output immediately so logs appear in real time
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
